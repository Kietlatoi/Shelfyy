# ============================================================
# Shelfy gitignore
# Giữ source, config mẫu và migration trong Git.
# Không commit secrets, dependencies local, build output, logs.
# ============================================================

# Secrets / environment files
.env
.env.*
*.env
**/.env
**/.env.*
!*.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Frontend build/cache output
dist/
**/dist/
.vite/
**/.vite/
.vercel/
**/.vercel/

# Java / Maven build output
target/
**/target/
.mvn/timing.properties

# Logs
*.log
*.out.log
*.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Runtime temp files
tmp/
temp/
*.tmp

# Local certificates / keys
*.pem
*.key
*.crt
*.p12
*.pfx
