PORT=3000

# Có thể dùng DATABASE_URL của Railway hoặc dùng nhóm biến DB_* giống BE local.
# Local hiện tại có thể trỏ tới Postgres Docker của BE.
DB_URL=jdbc:postgresql://localhost:15432/shelfy_db
DB_USERNAME=shelfy
DB_PASSWORD=shelfy_dev_password
DB_SSL=false

# Phải dùng cùng JWT_SECRET với Core API Service để verify access token do Java phát hành.
JWT_SECRET=shelfy-local-dev-jwt-secret-change-me-32-bytes-minimum

APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIME_ZONE=Asia/Ho_Chi_Minh
APP_TIME_ZONE_OFFSET=+07:00
APP_JSON_BODY_LIMIT=16mb

# VNPay payment service. Khi deploy production, return/ipn URL phải là URL public của Nodejs service.
NODE_PUBLIC_BASE_URL=http://localhost:3000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/callback
VNPAY_IPN_URL=http://localhost:3000/api/payments/vnpay/ipn

OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_MS=8000

REVERSE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODING_USER_AGENT=ShelfyWeatherService/0.1 (local-dev)
REVERSE_GEOCODING_LANGUAGE=vi,en
REVERSE_GEOCODING_ZOOM=10
REVERSE_GEOCODING_TIMEOUT_MS=5000
REVERSE_GEOCODING_MIN_INTERVAL_MS=1100
REVERSE_GEOCODING_CACHE_TTL_MS=86400000

# Google Calendar OAuth. Redirect URI này phải được thêm vào Google Cloud OAuth Client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_OAUTH_PROMPT=consent
GOOGLE_OAUTH_STATE_TTL_MS=600000
GOOGLE_CALENDAR_TIMEOUT_MS=10000

# Khuyến nghị tự sinh key 32 bytes cho production:
#   openssl rand -base64 32
# Nếu bỏ trống ở local, Nodejs sẽ derive key từ JWT_SECRET.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Optional Gemini provider. Suggestion mặc định đang dùng rule-based, không cần key này.
# Nếu bật lại AI provider sau này, API key là secret và chỉ đặt ở Nodejs service.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=2500

# Mặc định không để server fetch ảnh từ URL trong DB để tránh SSRF.
# Khi bật, Nodejs chỉ lấy ảnh HTTPS từ host allowlist, ví dụ Cloudinary.
GEMINI_INCLUDE_ITEM_IMAGES=false
GEMINI_IMAGE_ALLOWED_HOSTS=res.cloudinary.com
GEMINI_MAX_INLINE_IMAGES=8
GEMINI_MAX_IMAGE_BYTES=2500000

# Replicate virtual try-on provider. Dùng cho /api/trial.
REPLICATE_API_TOKEN=
REPLICATE_API_BASE_URL=https://api.replicate.com/v1
REPLICATE_IDM_VTON_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
REPLICATE_IDM_VTON_STEPS=30
REPLICATE_IDM_VTON_CROP=true
REPLICATE_TIMEOUT_MS=20000
TRY_ON_MAX_PERSON_IMAGE_BYTES=10485760
