# ==============================================================================
# Shelfy Docker Compose Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=shelfy_db
DB_USERNAME=postgres
DB_PASSWORD=shelfy_dev_password

# Spring Boot & Nodejs Security (Bắt buộc giống nhau để xác thực JWT)
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=shelfy-local-dev-jwt-secret-change-me-32-bytes-minimum
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=2592000000
JWT_REMEMBER_ME_REFRESH_EXPIRY=7776000000

# Application URLs & CORS
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_NODE_API_BASE_URL=http://localhost:3000/api

# Nodejs Timezone & Geocoding
APP_TIME_ZONE=Asia/Ho_Chi_Minh
APP_TIME_ZONE_OFFSET=+07:00
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_MS=8000
REVERSE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODING_USER_AGENT=ShelfyWeatherService/0.1 (local-dev)

# Cloudinary (Tùy chọn - lưu trữ ảnh tủ đồ, avatar)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail Configuration (Tùy chọn - gửi mail reset password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FAIL_OPEN=true

# Replicate AI Try-On (Tùy chọn - thử đồ ảo)
REPLICATE_API_URL=https://api.replicate.com/v1
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985

# Google Calendar OAuth (Tùy chọn - đồng bộ lịch trình)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=

# VNPay Payment (Tùy chọn - thanh toán gói Premium)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
