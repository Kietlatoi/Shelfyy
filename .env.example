# ============================================================
# TEMPLATE — copy file này thành ".env" rồi điền giá trị thật.
# File ".env" thật KHÔNG được commit lên git (đã có trong .gitignore).
# Secret nào cần xin trưởng nhóm / tự tạo tài khoản thì xem comment bên dưới.
# ============================================================

POSTGRES_DB=shelfy_db
DB_USERNAME=shelfy
# Tự đặt 1 mật khẩu bất kỳ cho Postgres chạy trong Docker (chỉ dùng nội bộ)
DB_PASSWORD=

SPRING_PROFILES_ACTIVE=dev

# Chuỗi bí mật để ký JWT — tự sinh 1 chuỗi ngẫu nhiên đủ dài, KHÔNG dùng lại
# chuỗi demo cũ hay chuỗi ai đó public. Có thể sinh nhanh bằng:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=2592000000
JWT_REMEMBER_ME_REFRESH_EXPIRY=7776000000

# Đăng ký free tại https://cloudinary.com/users/register/free
# Cả nhóm dùng chung 1 tài khoản, lấy 3 giá trị ở Dashboard rồi điền vào đây
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Đăng ký merchant sandbox (miễn phí) tại https://sandbox.vnpayment.vn
# để lấy Terminal ID (vnp_TmnCode) + Secret Key (HashSecret)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIME_ZONE=Asia/Ho_Chi_Minh
APP_TIME_ZONE_OFFSET=+07:00
VITE_API_BASE_URL=http://localhost:8080/api
VITE_NODE_API_BASE_URL=http://localhost:3000/api

# Weather thuộc Nodejs service và dùng Open-Meteo, không cần API key ở giai đoạn hiện tại.
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_MS=8000
REVERSE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODING_USER_AGENT=ShelfyWeatherService/0.1 (local-dev)
REVERSE_GEOCODING_LANGUAGE=vi,en
REVERSE_GEOCODING_ZOOM=10
REVERSE_GEOCODING_TIMEOUT_MS=5000
REVERSE_GEOCODING_MIN_INTERVAL_MS=1100
REVERSE_GEOCODING_CACHE_TTL_MS=86400000

# Google Calendar thuộc Nodejs service. Redirect URI phải khớp trong Google Cloud OAuth Client.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_OAUTH_PROMPT=consent
GOOGLE_OAUTH_STATE_TTL_MS=600000
GOOGLE_CALENDAR_TIMEOUT_MS=10000
CALENDAR_TOKEN_ENCRYPTION_KEY=

REPLICATE_API_URL=https://api.replicate.com/v1
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Dùng Gmail App Password (KHÔNG phải mật khẩu Gmail thường):
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

VITE_API_PROXY_TARGET=http://localhost:8080

APP_MAIL_FAIL_OPEN=true
