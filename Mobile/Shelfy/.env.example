# Local Firebase Emulator only. Replace these values with the Firebase app's
# public configuration before connecting to a real Firebase project.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-shelfy.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-shelfy
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:android:demo
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-southeast1
# Android package ID is fixed in app.config.js as com.shelfy.app.
# Optional: use only after configuring a custom Firebase Hosting link domain.
# EXPO_PUBLIC_FIREBASE_AUTH_LINK_DOMAIN=links.example.com
# Optional: HTTPS URL on a Firebase Auth authorized domain.
# EXPO_PUBLIC_FIREBASE_PASSWORD_RESET_CONTINUE_URL=https://demo-shelfy.firebaseapp.com

# Defaults work with iOS Simulator and Android Emulator. For a physical device,
# set this to the development computer's LAN address and allow emulator ports.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10
