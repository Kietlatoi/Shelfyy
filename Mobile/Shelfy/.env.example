EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=shelfy-acf38
EXPO_PUBLIC_FIREBASE_APP_ID=
# Cloudflare Worker URL, without a trailing slash.
EXPO_PUBLIC_EDGE_API_URL=
# Open-Meteo current weather endpoint. The default below works without an API key.
EXPO_PUBLIC_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
# Android package ID is fixed in app.config.js as com.shelfy.app.
# Optional: use only after configuring a custom Firebase Hosting link domain.
# EXPO_PUBLIC_FIREBASE_AUTH_LINK_DOMAIN=links.example.com
# Optional: HTTPS URL on a Firebase Auth authorized domain.
# EXPO_PUBLIC_FIREBASE_PASSWORD_RESET_CONTINUE_URL=https://shelfy-acf38.firebaseapp.com

# Defaults work with iOS Simulator and Android Emulator. For a physical device,
# set this to the development computer's LAN address and allow emulator ports.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10
