{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "false", "EXPO_PUBLIC_DISTRIBUTION_CHANNEL": "DIRECT" }
    },
    "apkpure": {
      "distribution": "internal",
      "environment": "production",
      "android": { "buildType": "apk", "autoIncrement": true },
      "env": { "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "false", "EXPO_PUBLIC_DISTRIBUTION_CHANNEL": "APKPURE" }
    },
    "production": {
      "environment": "production",
      "android": { "buildType": "app-bundle", "autoIncrement": true },
      "env": { "EXPO_PUBLIC_USE_FIREBASE_EMULATOR": "false", "EXPO_PUBLIC_DISTRIBUTION_CHANNEL": "GOOGLE_PLAY" }
    }
  }
}
