# Copy these parameters to functions/.env.<firebase-project-id> after creating
# the Firebase project. Use the exact callback URL registered in Google Cloud.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
# firebase functions:secrets:set CLOUDINARY_API_SECRET --project YOUR_PROJECT_ID

GOOGLE_CALENDAR_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_REDIRECT_URI=https://asia-southeast1-your-project-id.cloudfunctions.net/googleCalendarCallback

# Store the OAuth client secret in Firebase Secret Manager, never in this file:
# firebase functions:secrets:set GOOGLE_CALENDAR_CLIENT_SECRET

# Store the Replicate token in Firebase Secret Manager, never in this file:
# firebase functions:secrets:set REPLICATE_API_TOKEN
REPLICATE_IDM_VTON_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985

# VNPay sandbox only. Leave disabled until merchant credentials and HTTPS callbacks exist.
VNPAY_PAYMENT_ENABLED=false
VNPAY_TMN_CODE=your-sandbox-merchant-code
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://asia-southeast1-your-project-id.cloudfunctions.net/vnpayReturn
VNPAY_IPN_URL=https://asia-southeast1-your-project-id.cloudfunctions.net/vnpayIpn
# Store the shared signing key in Firebase Secret Manager, never in this file:
# firebase functions:secrets:set VNPAY_HASH_SECRET
