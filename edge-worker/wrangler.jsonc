{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelfy-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "vars": {
    "PUBLIC_BASE_URL": "https://shelfy-edge.shelfy-edge-worker.workers.dev",
    "APP_DEEP_LINK": "shelfy://payment/result",
    "PAYMENT_LINK_TTL_SECONDS": "900",
    "BILLING_RETENTION_DAYS": "3650"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      "id": "5082c7939f5f4958905123d3c21b7ee6"
    }
  ]
}
