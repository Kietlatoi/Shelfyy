# ================================================
# SHELFY - Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ================================================

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# JWT (tối thiểu 256-bit, random string dài)
JWT_SECRET=replace_with_your_very_long_random_secret_key_at_least_32_chars

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth2 + Calendar (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# VNPay Sandbox (https://sandbox.vnpayment.vn/devreg)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret

# Base URL của backend (dùng cho VNPay return URL)
APP_BASE_URL=http://localhost:8080

# OpenWeatherMap API (https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key
